# ============================================================
# Stock Evaluator configuration — copy to .env for local dev.
# On Railway, set these under the service's Variables tab instead.
# NEVER commit real values; .env is gitignored.
# ============================================================

# --- Web app auth (required for the web layer) ---
# Random secret that signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login. Generate the bcrypt hash with:
#   python scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- AI analyst API keys (per config/analysts.yaml api_key_env) ---
# Missing keys skip that analyst with a warning; they never crash a run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Database ---
# Local default is SQLite (file next to the app). On Railway, DO NOT set
# this by hand: add a Postgres service and Railway injects DATABASE_URL
# into the web service automatically (via the reference variable).
# DATABASE_URL=sqlite:///./stock_evaluator.db

# --- Analysis behavior ---
# Completed analyses younger than this are served from cache for free.
ANALYSIS_CACHE_HOURS=24
# Each running analysis costs API money — cap how many run at once.
MAX_CONCURRENT_ANALYSES=2
